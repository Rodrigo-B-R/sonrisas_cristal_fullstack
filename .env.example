# Copia este archivo como .env y llena tus valores. El .env nunca se sube a git.
# Este es el UNICO .env: la API, la BD, pgAdmin, Prometheus y Grafana leen de aqui.

# ── Versiones de las imagenes (GHCR: ghcr.io/rodrigo-b-r/...) ─────────
API_TAG=1.0.0
DB_TAG=1.0.0

# Genera cada secreto con:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=sonrisas_cristal

# Usuario de la API (solo SELECT, INSERT, UPDATE)
API_DB_PASSWORD=cambia-esto
# Usuario "monitor" para postgres_exporter (solo lee estadisticas)
MONITOR_DB_PASSWORD=cambia-esto

# ── API ──────────────────────────────────────────────────────────────
# Si la contraseña tiene caracteres especiales (# * ] ! = ^ @ : /) va CODIFICADA:
#   python -c "import urllib.parse as u; print(u.quote('tu-contraseña', safe=''))"
DATABASE_URL="postgresql+psycopg://api_user:<API_DB_PASSWORD codificada>@postgres:5432/sonrisas_cristal"
# Texto largo y secreto (minimo 32 caracteres):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENVIRONMENT=production
# La API la pide en /metrics (Authorization: Bearer ...) y Prometheus usa la misma. Si esta vacio, /metrics se apaga.
METRICS_TOKEN=
# Contraseña de las cuentas de demo de scripts/seed.py. OBLIGATORIA y privada (no uses la del ejemplo del repo).
SEED_PASSWORD=cambia-esto
# Con el tunel de Cloudflare: la subred de la red Docker (docker network inspect sonrisas_sonrisas_net)
TRUSTED_PROXIES=
# Puerto en tu PC (la API se oculta cuando entre Cloudflare)
API_PORT=8000
# Otras (opcionales, con su valor por defecto): JWT_EXPIRE_MINUTES, TZ, LATE_TOLERANCE_MINUTES,
# LOGIN_RATE_LIMIT, DEFAULT_RATE_LIMIT, LOGIN_MAX_FAILURES, LOGIN_LOCKOUT_MINUTES

# ── pgAdmin ──────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambia-esto
PGADMIN_PORT=5050

# ── Grafana / Prometheus ─────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esto
GRAFANA_PORT=3000
# PROMETHEUS_RETENTION=30d
